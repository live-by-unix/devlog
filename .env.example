# Devlog environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.

# --- Application ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# --- Storage ---
# Directory holding all persistent data. Defaults to ./data
DATA_DIR=./data

# --- Security ---
# REQUIRED in production: a long random secret used to sign session cookies
# and CSRF tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" when behind HTTPS / a TLS-terminating reverse proxy (nginx, ALB, Cloudflare)
COOKIE_SECURE=false

# Number of trusted proxy hops (e.g. 1 for nginx). "true" trusts all — avoid in production.
TRUST_PROXY=1

# Comma-separated allowed CORS origins. Leave empty when serving frontend from same origin.
ALLOWED_ORIGINS=

# --- Uploads ---
# Max upload size in megabytes (applies per file and per request)
MAX_UPLOAD_MB=100
# Max size for images (favicon / project / newsletter covers)
MAX_IMAGE_MB=5

# --- Sessions ---
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=72

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Optional: Cloudflare DNS integration (deploy/domain scripts only) ---
# CF_API_TOKEN=
# CF_ZONE_ID=
